# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# stale build / export snapshots. These are not matched by the rules above and
# would otherwise be committed AND scanned by Tailwind's automatic source
# detection (which slows every `next build` down considerably).
/.next-*/
/out-*/
/diag-output/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# E2E test artifacts
scripts/e2e/screenshots/

# itch upload artifact
/CircleGen.zip
